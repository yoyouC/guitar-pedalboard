{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && node scripts/check-publish-models.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    },
    {
      "source": "/api/marketplace/me/profile",
      "destination": "/api/marketplace-member?route=profile"
    },
    {
      "source": "/api/marketplace/me",
      "destination": "/api/marketplace-member?route=me"
    },
    {
      "source": "/api/marketplace/creators/:handle/presets",
      "destination": "/api/marketplace-member?route=creator-presets&handle=:handle"
    },
    {
      "source": "/api/marketplace/creators/:handle",
      "destination": "/api/marketplace-member?route=creator&handle=:handle"
    },
    {
      "source": "/api/marketplace/presets/:id",
      "destination": "/api/marketplace-preset"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/nam-wasm/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/irs/(.*).wav",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
