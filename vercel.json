{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && node scripts/check-publish-models.mjs",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/marketplace/presets/:id/revisions/:revisionId",
      "destination": "/marketplace/tones/:id/revisions/:revisionId",
      "permanent": true
    },
    {
      "source": "/marketplace/presets/:id",
      "destination": "/marketplace/tones/:id",
      "permanent": true
    },
    {
      "source": "/marketplace/search",
      "destination": "/marketplace",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/internal/marketplace/rebuild-trending",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/marketplace/purge-deleted-accounts",
      "schedule": "30 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    },
    {
      "source": "/api/marketplace/me/profile",
      "destination": "/api/marketplace-member?route=profile"
    },
    {
      "source": "/api/marketplace/health",
      "destination": "/api/marketplace-health"
    },
    {
      "source": "/api/marketplace/me/export",
      "destination": "/api/marketplace-account?route=export"
    },
    {
      "source": "/api/marketplace/me/deletion",
      "destination": "/api/marketplace-account?route=deletion"
    },
    {
      "source": "/api/marketplace/me",
      "destination": "/api/marketplace-member?route=me"
    },
    {
      "source": "/api/marketplace/creators/id/:memberId/presets",
      "destination": "/api/marketplace-member?route=creator-id-presets&memberId=:memberId"
    },
    {
      "source": "/api/marketplace/creators/id/:memberId",
      "destination": "/api/marketplace-member?route=creator-id&memberId=:memberId"
    },
    {
      "source": "/api/marketplace/creators/:handle/presets",
      "destination": "/api/marketplace-member?route=creator-presets&handle=:handle"
    },
    {
      "source": "/api/marketplace/creators/:handle",
      "destination": "/api/marketplace-member?route=creator&handle=:handle"
    },
    {
      "source": "/api/marketplace/tags",
      "destination": "/api/marketplace-preset?route=tags"
    },
    {
      "source": "/api/marketplace/me/tones",
      "destination": "/api/marketplace-preset?route=my-tones"
    },
    {
      "source": "/api/marketplace/admin/tags/audit",
      "destination": "/api/marketplace-tag-admin?route=audit"
    },
    {
      "source": "/api/marketplace/admin/tags/:id/deprecate",
      "destination": "/api/marketplace-tag-admin?route=deprecate&id=:id"
    },
    {
      "source": "/api/marketplace/admin/tags/:id/merge",
      "destination": "/api/marketplace-tag-admin?route=merge&id=:id"
    },
    {
      "source": "/api/marketplace/admin/tags/:id",
      "destination": "/api/marketplace-tag-admin?route=tag&id=:id"
    },
    {
      "source": "/api/marketplace/admin/tags",
      "destination": "/api/marketplace-tag-admin?route=tags"
    },
    {
      "source": "/api/marketplace/search/presets",
      "destination": "/api/marketplace-search?route=presets"
    },
    {
      "source": "/api/marketplace/search/collections",
      "destination": "/api/marketplace-search?route=collections"
    },
    {
      "source": "/api/marketplace/search/creators",
      "destination": "/api/marketplace-search?route=creators"
    },
    {
      "source": "/api/marketplace/me/likes",
      "destination": "/api/marketplace-like?route=mine"
    },
    {
      "source": "/api/marketplace/reports",
      "destination": "/api/marketplace-moderation?route=reports"
    },
    {
      "source": "/api/marketplace/infringement-notices",
      "destination": "/api/marketplace-moderation?route=notice"
    },
    {
      "source": "/api/marketplace/me/moderation",
      "destination": "/api/marketplace-moderation?route=mine"
    },
    {
      "source": "/api/marketplace/moderation/appeals",
      "destination": "/api/marketplace-moderation?route=appeals"
    },
    {
      "source": "/api/marketplace/admin/moderation/queue",
      "destination": "/api/marketplace-moderation?route=queue"
    },
    {
      "source": "/api/marketplace/admin/moderation/actions",
      "destination": "/api/marketplace-moderation?route=actions"
    },
    {
      "source": "/api/marketplace/admin/moderation/appeals",
      "destination": "/api/marketplace-moderation?route=admin-appeals"
    },
    {
      "source": "/api/marketplace/admin/moderation/audit",
      "destination": "/api/marketplace-moderation?route=audit"
    },
    {
      "source": "/api/marketplace/popular/presets",
      "destination": "/api/marketplace-like?route=popular-presets"
    },
    {
      "source": "/api/marketplace/popular/collections",
      "destination": "/api/marketplace-like?route=popular-collections"
    },
    {
      "source": "/api/marketplace/trending/presets",
      "destination": "/api/marketplace-like?route=trending-presets"
    },
    {
      "source": "/api/marketplace/trending/collections",
      "destination": "/api/marketplace-like?route=trending-collections"
    },
    {
      "source": "/api/internal/marketplace/rebuild-trending",
      "destination": "/api/marketplace-trending-rebuild"
    },
    {
      "source": "/api/internal/marketplace/purge-deleted-accounts",
      "destination": "/api/marketplace-account?route=purge"
    },
    {
      "source": "/api/marketplace/likes/presets/:id",
      "destination": "/api/marketplace-like?route=like-preset&id=:id"
    },
    {
      "source": "/api/marketplace/likes/collections/:id",
      "destination": "/api/marketplace-like?route=like-collection&id=:id"
    },
    {
      "source": "/api/marketplace/presets",
      "destination": "/api/marketplace-preset?route=presets"
    },
    {
      "source": "/api/marketplace/presets/:id/revisions/:revisionId/restore",
      "destination": "/api/marketplace-preset?route=revision-restore&id=:id&revisionId=:revisionId"
    },
    {
      "source": "/api/marketplace/presets/:id/revisions/:revisionId/compatibility",
      "destination": "/api/marketplace-preset?route=revision-compatibility&id=:id&revisionId=:revisionId"
    },
    {
      "source": "/api/marketplace/presets/:id/revisions/:revisionId",
      "destination": "/api/marketplace-preset?route=revision&id=:id&revisionId=:revisionId"
    },
    {
      "source": "/api/marketplace/presets/:id/revisions",
      "destination": "/api/marketplace-preset?route=revisions&id=:id"
    },
    {
      "source": "/api/marketplace/presets/:id/metadata",
      "destination": "/api/marketplace-preset?route=metadata&id=:id"
    },
    {
      "source": "/api/marketplace/presets/:id/manage",
      "destination": "/api/marketplace-preset?route=manage&id=:id"
    },
    {
      "source": "/api/marketplace/presets/:id/visibility",
      "destination": "/api/marketplace-preset?route=visibility&id=:id"
    },
    {
      "source": "/api/marketplace/presets/:id",
      "destination": "/api/marketplace-preset?route=preset&id=:id"
    },
    {
      "source": "/api/marketplace/me/collections",
      "destination": "/api/marketplace-collection?route=my-collections"
    },
    {
      "source": "/api/marketplace/collections",
      "destination": "/api/marketplace-collection?route=collections"
    },
    {
      "source": "/api/marketplace/collections/:id/manage",
      "destination": "/api/marketplace-collection?route=manage&id=:id"
    },
    {
      "source": "/api/marketplace/collections/:id",
      "destination": "/api/marketplace-collection?route=collection&id=:id"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/nam-wasm/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/irs/(.*).wav",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
